generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  MANAGEMENT
  CASHIER
  SCHOOL_CONTROL
  READ_ONLY
}

enum Sex {
  FEMALE
  MALE
  OTHER
  NOT_SPECIFIED
}

enum AdministrativeStatus {
  ACTIVE
  CURRENT
  WITH_DEBT
  TEMPORARY_LEAVE
  GRADUATED
}

enum EnrollmentStatus {
  ACTIVE
  FINISHED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  RECEIVED
  REVIEW
  REJECTED
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum PaymentStatus {
  APPLIED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

enum FollowUpType {
  ACADEMIC
  PAYMENT
  DOCUMENT
  ADMINISTRATIVE
}

enum ReEnrollmentStatus {
  DRAFT
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
  CANCELLED
}

enum AcademicEventType {
  EXAM
  COURSE_START
  COURSE_END
  CLASS_SESSION
  HOLIDAY
  SUSPENSION
  GRADE_DEADLINE
  INSTITUTIONAL
  OTHER
}

enum AcademicEventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(READ_ONLY)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  payments     Payment[]
  followUps    FollowUp[]
  auditLogs    AuditLog[]
  reEnrollments ReEnrollment[]
  academicEvents AcademicCalendarEvent[]

  @@index([role])
}

model Student {
  id                   String               @id @default(uuid())
  enrollmentNumber     String               @unique
  firstName            String
  paternalLastName     String
  maternalLastName     String?
  birthDate            DateTime?
  curp                 String?              @unique
  sex                  Sex?
  maritalStatus        String?
  occupation           String?
  phone                String?
  email                String?
  street               String?
  neighborhood         String?
  city                 String?
  state                String?
  postalCode           String?
  administrativeStatus AdministrativeStatus @default(ACTIVE)
  observations         String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  enrollments          Enrollment[]
  documents            StudentDocument[]
  payments             Payment[]
  followUps            FollowUp[]
  reEnrollments        ReEnrollment[]

  @@index([paternalLastName, maternalLastName, firstName])
  @@index([administrativeStatus])
  @@index([createdAt])
}

model Enrollment {
  id                 String           @id @default(uuid())
  studentId          String
  academicLevelId    String
  modalityId         String
  groupId            String?
  schoolCycleId      String?
  academicPeriodId   String?
  grade              String?
  fourMonthPeriod    Int?
  enrollmentDate     DateTime
  startDate          DateTime?
  endDate            DateTime?
  registrationFee    Decimal          @default(0) @db.Decimal(10, 2)
  weeklyFee          Decimal          @default(0) @db.Decimal(10, 2)
  lateFeePercentage  Decimal          @default(0) @db.Decimal(5, 2)
  paymentDay         Int?
  status             EnrollmentStatus @default(ACTIVE)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicLevel      AcademicLevel    @relation(fields: [academicLevelId], references: [id])
  modality           Modality         @relation(fields: [modalityId], references: [id])
  group              Group?           @relation(fields: [groupId], references: [id])
  schoolCycle        SchoolCycle?     @relation(fields: [schoolCycleId], references: [id])
  academicPeriod     AcademicPeriod?  @relation(fields: [academicPeriodId], references: [id])
  charges            Charge[]
  sourceReEnrollment ReEnrollment?    @relation("ReEnrollmentResult")

  @@index([studentId])
  @@index([academicLevelId, modalityId, groupId])
  @@index([schoolCycleId, academicPeriodId])
  @@index([status])
  @@index([enrollmentDate])
}

model AcademicLevel {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  active      Boolean      @default(true)
  modalities  Modality[]
  groups      Group[]
  enrollments Enrollment[]
  reEnrollments ReEnrollment[]
  subjects    Subject[]
  academicAssignments AcademicAssignment[]
  academicEvents AcademicCalendarEvent[]
}

model Modality {
  id              String        @id @default(uuid())
  academicLevelId String
  name            String
  code            String        @unique
  active          Boolean       @default(true)
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id])
  groups          Group[]
  enrollments     Enrollment[]
  reEnrollments   ReEnrollment[]
  subjects        Subject[]
  academicAssignments AcademicAssignment[]
  academicEvents AcademicCalendarEvent[]

  @@index([academicLevelId])
}

model Group {
  id              String        @id @default(uuid())
  name            String
  academicLevelId String
  modalityId      String
  schedule        String?
  capacity        Int?
  active          Boolean       @default(true)
  academicLevel   AcademicLevel @relation(fields: [academicLevelId], references: [id])
  modality        Modality      @relation(fields: [modalityId], references: [id])
  enrollments     Enrollment[]
  reEnrollments   ReEnrollment[]
  academicAssignments AcademicAssignment[]
  academicEvents  AcademicCalendarEvent[]

  @@index([academicLevelId, modalityId])
}

model DocumentType {
  id        String            @id @default(uuid())
  name      String
  required  Boolean           @default(true)
  active    Boolean           @default(true)
  documents StudentDocument[]
}

model StudentDocument {
  id               String         @id @default(uuid())
  studentId        String
  documentTypeId   String
  status           DocumentStatus @default(PENDING)
  physicalLocation String?
  fileUrl          String?
  receivedAt       DateTime?
  observations     String?
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType     DocumentType   @relation(fields: [documentTypeId], references: [id])

  @@unique([studentId, documentTypeId])
  @@index([status])
}

model ChargeConcept {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  defaultAmount Decimal  @default(0) @db.Decimal(10, 2)
  active        Boolean  @default(true)
  charges       Charge[]
}

model Charge {
  id               String               @id @default(uuid())
  enrollmentId     String
  chargeConceptId  String
  dueDate          DateTime
  baseAmount       Decimal              @db.Decimal(10, 2)
  surchargeAmount  Decimal              @default(0) @db.Decimal(10, 2)
  discountAmount   Decimal              @default(0) @db.Decimal(10, 2)
  balance          Decimal              @db.Decimal(10, 2)
  status           ChargeStatus         @default(PENDING)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  enrollment       Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  chargeConcept    ChargeConcept        @relation(fields: [chargeConceptId], references: [id])
  paymentApplications PaymentApplication[]
  reEnrollment     ReEnrollment?

  @@index([enrollmentId])
  @@index([dueDate, status])
}

model Payment {
  id                  String               @id @default(uuid())
  studentId           String
  amount              Decimal              @db.Decimal(10, 2)
  paymentMethod       PaymentMethod        @default(CASH)
  reference           String?
  paidAt              DateTime
  status              PaymentStatus        @default(APPLIED)
  createdById         String?
  createdAt           DateTime             @default(now())
  student             Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy           User?                @relation(fields: [createdById], references: [id])
  applications        PaymentApplication[]
  receipt             Receipt?

  @@index([studentId])
  @@index([paidAt])
}

model PaymentApplication {
  id        String  @id @default(uuid())
  paymentId String
  chargeId  String
  amount    Decimal @db.Decimal(10, 2)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  charge    Charge  @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@unique([paymentId, chargeId])
}

model Receipt {
  id        String   @id @default(uuid())
  paymentId String   @unique
  folio     String   @unique
  pdfUrl    String?
  createdAt DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model FollowUp {
  id             String       @id @default(uuid())
  studentId      String
  type           FollowUpType
  description    String
  nextFollowUpAt DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdBy      User?        @relation(fields: [createdById], references: [id])

  @@index([studentId, type])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  entity       String
  entityId     String
  previousData Json?
  newData      Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

model SchoolCycle {
  id              String                  @id @default(uuid())
  name            String                  @unique
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  periods         AcademicPeriod[]
  enrollments     Enrollment[]
  reEnrollments   ReEnrollment[]
  academicEvents  AcademicCalendarEvent[]

  @@index([isActive])
  @@index([startDate, endDate])
}

model AcademicPeriod {
  id              String                  @id @default(uuid())
  schoolCycleId   String
  name            String
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  schoolCycle     SchoolCycle             @relation(fields: [schoolCycleId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  reEnrollments   ReEnrollment[]
  academicAssignments AcademicAssignment[]
  academicEvents  AcademicCalendarEvent[]

  @@unique([schoolCycleId, name])
  @@index([schoolCycleId, isActive])
  @@index([startDate, endDate])
}

model ReEnrollment {
  id                  String             @id @default(uuid())
  studentId           String
  schoolCycleId       String
  academicPeriodId    String?
  academicLevelId     String
  modalityId          String
  groupId             String?
  chargeId            String             @unique
  resultingEnrollmentId String?          @unique
  status              ReEnrollmentStatus @default(DRAFT)
  dueDate             DateTime
  lateFeePercentage   Decimal            @default(0) @db.Decimal(5, 2)
  createdById         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolCycle         SchoolCycle        @relation(fields: [schoolCycleId], references: [id])
  academicPeriod      AcademicPeriod?    @relation(fields: [academicPeriodId], references: [id])
  academicLevel       AcademicLevel      @relation(fields: [academicLevelId], references: [id])
  modality            Modality           @relation(fields: [modalityId], references: [id])
  group               Group?             @relation(fields: [groupId], references: [id])
  charge              Charge             @relation(fields: [chargeId], references: [id])
  resultingEnrollment Enrollment?         @relation("ReEnrollmentResult", fields: [resultingEnrollmentId], references: [id])
  createdBy           User?              @relation(fields: [createdById], references: [id])

  @@index([studentId, schoolCycleId, academicLevelId, modalityId, groupId, academicPeriodId])
  @@index([status])
  @@index([dueDate])
}

model Subject {
  id              String               @id @default(uuid())
  name            String
  code            String               @unique
  academicLevelId String
  modalityId      String?
  active          Boolean              @default(true)
  academicLevel   AcademicLevel        @relation(fields: [academicLevelId], references: [id])
  modality        Modality?            @relation(fields: [modalityId], references: [id])
  academicAssignments AcademicAssignment[]
  academicEvents  AcademicCalendarEvent[]

  @@index([academicLevelId, modalityId])
  @@index([active])
}

model Teacher {
  id              String               @id @default(uuid())
  name            String
  email           String?              @unique
  phone           String?
  active          Boolean              @default(true)
  academicAssignments AcademicAssignment[]
  academicEvents  AcademicCalendarEvent[]

  @@index([active])
}

model Classroom {
  id              String               @id @default(uuid())
  name            String               @unique
  location        String?
  capacity        Int?
  active          Boolean              @default(true)
  academicAssignments AcademicAssignment[]
  academicEvents  AcademicCalendarEvent[]

  @@index([active])
}

model AcademicAssignment {
  id               String             @id @default(uuid())
  subjectId        String
  groupId          String
  teacherId        String
  classroomId      String?
  academicPeriodId String
  academicLevelId  String
  modalityId       String
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  subject          Subject            @relation(fields: [subjectId], references: [id])
  group            Group              @relation(fields: [groupId], references: [id])
  teacher          Teacher            @relation(fields: [teacherId], references: [id])
  classroom        Classroom?         @relation(fields: [classroomId], references: [id])
  academicPeriod   AcademicPeriod     @relation(fields: [academicPeriodId], references: [id], onDelete: Cascade)
  academicLevel    AcademicLevel      @relation(fields: [academicLevelId], references: [id])
  modality         Modality           @relation(fields: [modalityId], references: [id])
  scheduleRules    ScheduleRule[]

  @@index([academicPeriodId, groupId])
  @@index([academicPeriodId, teacherId])
  @@index([academicPeriodId, classroomId])
  @@index([subjectId])
}

model ScheduleRule {
  id                   String             @id @default(uuid())
  academicAssignmentId String
  weekday              Weekday
  startTime            String
  endTime              String
  startDate            DateTime
  endDate              DateTime
  active               Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  academicAssignment   AcademicAssignment @relation(fields: [academicAssignmentId], references: [id], onDelete: Cascade)

  @@index([academicAssignmentId])
  @@index([weekday, startDate, endDate])
  @@index([active])
}

model AcademicCalendarEvent {
  id               String              @id @default(uuid())
  title            String
  description      String?
  type             AcademicEventType
  startsAt         DateTime
  endsAt           DateTime
  allDay           Boolean             @default(false)
  schoolCycleId    String?
  academicPeriodId String?
  academicLevelId  String?
  modalityId       String?
  groupId          String?
  subjectId        String?
  teacherId        String?
  classroomId      String?
  status           AcademicEventStatus @default(SCHEDULED)
  reminderAt       DateTime?
  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  schoolCycle      SchoolCycle?        @relation(fields: [schoolCycleId], references: [id])
  academicPeriod   AcademicPeriod?     @relation(fields: [academicPeriodId], references: [id])
  academicLevel    AcademicLevel?      @relation(fields: [academicLevelId], references: [id])
  modality         Modality?           @relation(fields: [modalityId], references: [id])
  group            Group?              @relation(fields: [groupId], references: [id])
  subject          Subject?            @relation(fields: [subjectId], references: [id])
  teacher          Teacher?            @relation(fields: [teacherId], references: [id])
  classroom        Classroom?          @relation(fields: [classroomId], references: [id])
  createdBy        User?               @relation(fields: [createdById], references: [id])

  @@index([startsAt, endsAt])
  @@index([type])
  @@index([schoolCycleId, academicPeriodId])
  @@index([groupId])
  @@index([teacherId])
  @@index([subjectId])
}
